# ─── Boomlify Temp Mail API ────────────────────────────────────────────────────
# Register at https://boomlify.com/register to get your API key
BOOMLIFY_API_KEY=your_boomlify_api_key_here

# ─── Neon Database (PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/meetlog?sslmode=require

# ─── Sarvam Signup Config ──────────────────────────────────────────────────────
# Password used for all auto-generated Sarvam accounts
SARVAM_DEFAULT_PASSWORD=MeetLog2026!@#

# Number of accounts to provision (max 50 per run due to Boomlify free tier)
SARVAM_ACCOUNT_COUNT=50

# Delay between accounts in seconds (avoid rate limiting)
SARVAM_DELAY_BETWEEN_ACCOUNTS=30

# ─── Browser Config ────────────────────────────────────────────────────────────
# Set to false to see browser automation in action (debugging)
HEADLESS_MODE=true
