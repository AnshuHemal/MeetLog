# ─── App ──────────────────────────────────────────────────────────────────────
# The public URL of your deployment (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_secret_here

# Must match NEXT_PUBLIC_APP_URL
BETTER_AUTH_URL=http://localhost:3000

# Optional: Better Auth API key for server-to-server calls
BETTER_AUTH_API_KEY=your_api_key_here

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local: no SSL needed. Remote (Neon/Supabase/etc.): use sslmode=verify-full
DATABASE_URL=postgresql://user:password@localhost:5432/meetlog

# ─── Brevo SMTP (email) ───────────────────────────────────────────────────────
# Sign up at https://brevo.com — free tier: 300 emails/day
# Find credentials at: Brevo → SMTP & API → SMTP tab
BREVO_SMTP_USER=your_brevo_login@smtp-brevo.com
BREVO_SMTP_PASS=your_brevo_smtp_key

# Must be a verified sender in Brevo → Senders & IPs → Senders
EMAIL_FROM=MeetLog <noreply@yourdomain.com>

# ─── OAuth — Google ───────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── OAuth — GitHub ───────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ─── Sarvam AI ────────────────────────────────────────────────────────────────
# Get key from Sarvam AI Developer Dashboard
SARVAM_API_KEY=your_sarvam_api_key_here

# ─── Gemini AI (LLM) ──────────────────────────────────────────────────────────
# Get key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Cloudinary (File Storage) ────────────────────────────────────────────────
# Cloud Name, API Key, and Secret from Cloudinary Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
