// ─────────────────────────────────────────────────────────────────────────────
// MeetLog — Prisma Schema
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth core tables ──────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  workspaceMembers WorkspaceMember[]
  sentInvitations Invitation[]
  presences     UserPresence[]
  aiChatMessages AIChatMessage[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("verifications")
}

// ─── MeetLog Workspace & Meeting models ───────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   WorkspaceMember[]
  meetings  Meeting[]
  invitations Invitation[]
  integrations WorkspaceIntegration[]
  aiChatMessages AIChatMessage[]
  vocabularies WorkspaceVocabulary[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Meeting {
  id             String        @id @default(cuid())
  workspaceId    String
  title          String
  description    String?
  audioUrl       String
  durationSeconds Float
  status         MeetingStatus @default(UPLOADED)
  sarvamJobId    String?       @unique
  languageCode   String        @default("en-IN")
  numSpeakers    Int?
  summaryMarkdown String?      @db.Text
  chaptersJson    String?      @db.Text
  isPublic       Boolean       @default(false)
  shareToken     String?       @unique
  retryCount     Int           @default(0)
  lastError      String?       @db.Text
  progressMessage String?      @db.Text
  nextRetryAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  segments  TranscriptSegment[]
  speakerLabels SpeakerLabel[]
  actionItems ActionItem[]
  presences UserPresence[]

  @@index([status, nextRetryAt])
  @@map("meetings")
}

enum MeetingStatus {
  UPLOADED
  TRANSCRIBING
  COMPLETED
  FAILED
}

model TranscriptSegment {
  id          String   @id @default(cuid())
  meetingId   String
  speakerId   String   // E.g., SPEAKER_00
  startTime   Float    // Seconds from start
  endTime     Float    // Seconds from start
  text        String   @db.Text
  index       Int      // Sequence order
  highlightColor String?
  noteText       String?  @db.Text
  sentiment      String?  // "positive" | "neutral" | "negative"
  isEdited       Boolean  @default(false)

  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("transcript_segments")
}

model SpeakerLabel {
  id          String   @id @default(cuid())
  meetingId   String
  speakerId   String   // E.g., SPEAKER_00
  displayName String   // Custom editable name, defaults to Speaker 1, Speaker 2, etc.

  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, speakerId])
  @@map("speaker_labels")
}

model ActionItem {
  id             String           @id @default(cuid())
  meetingId      String
  taskDescription String          @db.Text
  assigneeName   String?          // Dynamic name of the speaker assigned
  status         ActionItemStatus @default(PENDING)
  priority       ActionItemPriority @default(MEDIUM)
  dueDate        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  meeting        Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("action_items")
}

enum ActionItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ActionItemPriority {
  HIGH
  MEDIUM
  LOW
}

model Invitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId, email])
  @@map("invitations")
}

enum IntegrationType {
  SLACK
  JIRA
  LINEAR
  NOTION
}

model WorkspaceIntegration {
  id          String          @id @default(cuid())
  workspaceId String
  type        IntegrationType
  webhookUrl  String?         // Slack incoming webhook
  apiKey      String?         // Jira / Linear API key
  projectKey  String?         // Jira project key
  teamId      String?         // Linear team ID
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type])
  @@map("workspace_integrations")
}
model UserPresence {
  id        String   @id @default(cuid())
  userId    String
  meetingId String
  updatedAt DateTime @updatedAt @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([userId, meetingId])
  @@map("user_presences")
}

model AIChatMessage {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  sender      String   // "user" | "ai"
  text        String   @db.Text
  citations   String?  @db.Text // JSON string array
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("ai_chat_messages")
}

model WorkspaceVocabulary {
  id          String   @id @default(cuid())
  workspaceId String
  term        String
  category    String?  // "ACRONYM" | "BRAND" | "TECH" | "NAME"
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, term])
  @@map("workspace_vocabularies")
}

model ApiKeyPool {
  id               String    @id @default(cuid())
  provider         String    // "SARVAM" | "GROQ" | "OPENAI" | "GEMINI"
  key              String    @db.Text
  label            String?
  status           String    @default("ACTIVE") // "ACTIVE" | "RATE_LIMITED" | "EXHAUSTED" | "DISABLED"
  rateLimitResetAt DateTime?
  usageCount       Int       @default(0)
  errorCount       Int       @default(0)
  lastUsedAt       DateTime?
  lastError        String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  provisionedAccounts SarvamProvisionedAccount[]

  @@index([provider, status])
  @@map("api_key_pools")
}

model SarvamProvisionedAccount {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String   @db.Text
  apiKeyPoolId  String?
  status        String   @default("PROVISIONED") // "PROVISIONED" | "ACTIVE" | "EXPIRED" | "FAILED"
  lastError     String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  apiKeyPool ApiKeyPool? @relation(fields: [apiKeyPoolId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("sarvam_provisioned_accounts")
}
